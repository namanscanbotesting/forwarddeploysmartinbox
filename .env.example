# =============================================================================
# Smart Inbox Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Oracle Database Configuration
# -----------------------------------------------------------------------------
# Hostname or IP address of the Oracle database server
ORACLE_HOST=localhost

# Port number for Oracle listener (default: 1521)
ORACLE_PORT=1521

# Oracle Service Name (for Oracle Free/Express: FREEPDB1)
ORACLE_SERVICE=FREEPDB1

# Database credentials
ORACLE_USERNAME=inbox_admin
ORACLE_PASSWORD=inbox_password

# -----------------------------------------------------------------------------
# Spring Boot Application Configuration
# -----------------------------------------------------------------------------
# Server port for the Spring Boot API (default: 8080)
SERVER_PORT=8080

# Admin user credentials for basic authentication
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=admin123

# URL of the Python AI service
AI_SERVICE_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# AI/LLM Configuration (OpenAI-Compatible API)
# -----------------------------------------------------------------------------
# Base URL for OpenAI-compatible API endpoint
# Examples:
#   - OpenAI: https://api.openai.com/v1
#   - Azure OpenAI: https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
#   - Local LLM (Ollama): http://localhost:11434/v1
#   - Local LLM (vLLM): http://localhost:8000/v1
#   - Other compatible providers: https://api.anthropic.com/v1 (with adapter)
AI_BASE_URL=https://api.openai.com/v1

# API Key for the AI service
# Get from: https://platform.openai.com/api-keys (for OpenAI)
# Or your provider's equivalent
AI_API_KEY=sk-your-actual-api-key-here

# Model name to use for classification and extraction
# OpenAI examples: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Azure: your-deployment-name
# Local: model name as configured in your LLM server
AI_MODEL=gpt-4o

# Optional: Timeout for AI API calls (in seconds)
AI_TIMEOUT=120

# Optional: Maximum tokens for AI responses
AI_MAX_TOKENS=4096

# Optional: Temperature for AI generation (0.0 = deterministic, 1.0 = creative)
AI_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Mail Configuration (Optional - for IMAP polling)
# -----------------------------------------------------------------------------
# IMAP server hostname
MAIL_IMAP_HOST=imap.gmail.com

# IMAP server port (993 for SSL, 143 for STARTTLS)
MAIL_IMAP_PORT=993

# Email account credentials
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Folder to poll (default: INBOX)
MAIL_FOLDER=INBOX

# Polling interval in milliseconds (default: 60000 = 1 minute)
MAIL_POLL_INTERVAL=60000

# Enable/disable IMAP polling (true/false)
MAIL_POLLING_ENABLED=false

# -----------------------------------------------------------------------------
# File Storage Configuration
# -----------------------------------------------------------------------------
# Directory for storing uploaded attachments (absolute path)
FILE_STORAGE_PATH=/tmp/inbox-attachments

# Maximum file size in bytes (default: 10MB)
FILE_MAX_SIZE=10485760

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE_PATH=/tmp/smart-inbox-assistant.log

# -----------------------------------------------------------------------------
# CORS Configuration (Angular UI)
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# -----------------------------------------------------------------------------
# Async Queue Configuration
# -----------------------------------------------------------------------------
# Thread pool size for async processing
ASYNC_THREAD_POOL_SIZE=5

# Queue capacity for async tasks
ASYNC_QUEUE_CAPACITY=100
